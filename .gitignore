# runtime state when running straight from src/: users, settings, activity log, caches, local overrides
/src/_h6ai/private/data/*
!/src/_h6ai/private/data/README.md
/src/_h6ai/private/cache/*
!/src/_h6ai/private/cache/README.md
!/src/_h6ai/private/cache/index.php
/src/_h6ai/public/cache/
/src/_h6ai/private/conf/options.local.json
/.claude/scheduled_tasks.lock

# local Docker settings (see .env.example) and the default shared folder of compose.yaml
/.env
/files/
/test-native/logs/
