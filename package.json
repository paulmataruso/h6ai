{
  "name": "h6ai",
  "version": "1.0.0",
  "description": "h6ai: a modern, secure file index for nginx + PHP-FPM with users, folder permissions and previews.",
  "keywords": [
    "file-index",
    "directory-listing",
    "nginx",
    "php",
    "file-server",
    "autoindex"
  ],
  "author": "h6ai contributors",
  "contributors": [
    "Lars Jung <lrsjng@gmail.com> (https://larsjung.de), original h5ai"
  ],
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "build:dev": "node build.mjs --dev",
    "release": "node build.mjs --release",
    "watch": "node build.mjs --dev --watch",
    "lint": "eslint .",
    "test": "node --experimental-require-module --no-warnings=ExperimentalWarning --test test/*.test.js",
    "check": "npm run -s lint && npm run -s test",
    "test:integration": "sh test-integration/run.sh",
    "test:e2e": "sh test-e2e/run.sh",
    "lint:php": "docker run --rm -v \"$PWD/src:/src\" php:8.3-cli sh -c 'find /src -name \"*.php\" -exec php -l {} \\; | grep -v \"^No syntax\" || true'"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "kjua": "0.10.0",
    "lolight": "1.4.1",
    "marked": "18.1.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "jsdom": "26.1.0"
  }
}
