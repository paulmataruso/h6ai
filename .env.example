# h6ai Docker settings. Copy to .env (next to compose.yaml) and adjust.

# Folder to share. h6ai adds a hidden _h6ai folder to it; your files are never modified.
H6AI_FILES=./files

# Address and port to publish. 0.0.0.0 = all interfaces, e.g. 192.168.1.10 for one.
H6AI_BIND=0.0.0.0
H6AI_PORT=8080

# First admin, created on the first start. Leave the password empty to have one generated and
# printed in `docker compose logs h6ai`.
H6AI_ADMIN_USER=admin
H6AI_ADMIN_PASSWORD=

# Development: sample tree, bootstrap login admin/admin-test, port 8687 (see compose.dev.yaml).
#COMPOSE_FILE=compose.yaml:compose.dev.yaml
