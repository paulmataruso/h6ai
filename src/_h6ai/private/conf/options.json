{
    /*
    Tip: don't edit this file. Put your changes into "options.local.json" next to it.
    That file is deep-merged over this one (objects are merged, arrays and values replaced)
    and it is not overwritten when you upgrade h6ai. Example:

        {"passhash": "$2y$10$...", "search": {"enabled": true}}
    */



    /*
    Password hash for the info page (admin) login.

    Empty means no password is set and the login is disabled.
    Create a hash with:  php _h6ai/private/bin/h6ai-passhash.php
    or:                  php -r 'echo password_hash("your password", PASSWORD_DEFAULT), PHP_EOL;'

    Legacy unsalted SHA-512 hex hashes are still accepted but should be replaced.
    The environment variable H6AI_PASSHASH takes precedence over this value.
    */
    "passhash": "",



    /*
    Security settings.

    - csp: true for an automatically derived Content-Security-Policy, false to send none,
        or a custom policy string ("{nonce}" is replaced by the per-request nonce)
    - loginMaxAttempts: number, failed logins per client IP before the login is locked
    - loginWindow: number, seconds a failed login counts against the limit
    - sessionMaxAge: number, seconds after which a login expires

    Users, roles and folder permissions are managed in the admin UI ("_h6ai/public/", log in
    as an admin) and stored in "_h6ai/private/data/auth.json". Folder permissions only protect
    files if nginx asks h6ai before serving them (auth_request), see docs/DEPLOYMENT.md.
    */
    "security": {
        "csp": true,
        "loginMaxAttempts": 5,
        "loginWindow": 900,
        "sessionMaxAge": 43200
    },



    /*
    Resources.

    Additional script and style tags added to all pages. Paths not beginning
    with "http://", "https://", "//" or "/" will be looked up relative to
    "_h6ai/public/ext/" (no check for existence). External origins are added
    to the Content-Security-Policy automatically.

    - scripts: array of strings
    - styles: array of strings
    */
    "resources": {
        "scripts": [],
        "styles": []
    },



    /*
    General view options.

    - binaryPrefix: boolean, set to true uses 1024B=1KiB when formatting file sizes (see http://en.wikipedia.org/wiki/Binary_prefix)
    Colour themes (all dark) and what a click on a file name does are set on the admin page
    (Appearance); visitors can pick another theme for themselves in the settings drawer.
    - disableSidebar: boolean, hides sidebar and toggle button
    - fallbackMode: boolean, serve fallback mode
    - fastBrowsing: boolean, use History API if available (no need to reload the whole page)
    - fonts: array of strings, fonts to use in regular context, empty for the system font stack
    - fontsMono: array of strings, fonts to use in monospaced context, empty for the system stack
    - hidden: array of strings, don't list items matching these regular expressions.
        Note: hiding is not access control, hidden files can still be fetched by URL.
        Use your web server's configuration to deny access.
    - hideFolders: boolean, hide all folders in the main view
    - hideIf403: boolean, hide files and folders that are not readable by the server
    - hideParentFolder: boolean, hide parent folder links in the main view
    - maxEntries: number, max entries listed per folder (protects server memory)
    - maxIconSize: number, max size for icons in the main view
    - modes: array of strings, subset of ["details", "grid", "icons"]
        the first value indicates the default view mode. If only one value
        is given the view mode is fixed and the selector buttons are hidden.
        The user selected view mode is also stored local in modern browsers
        so that it will be persistent.
    - modeToggle: boolean, show a view mode toggle in the toolbar, or "next"
    - setParentFolderLabels: boolean, set parent folder labels to real folder names
    - sizes: array of numbers
        the first value indicates the default view size. If only one value
        is given the view size is fixed and the selector buttons are hidden.
        The user selected view size is also stored local in modern browsers
        so that it will be persistent.
    - theme: string, name of one of the folders in "_h6ai/public/images/themes", defaults to "default"
    - unmanaged: array of strings, don't manage folders containing one of those files
    - unmanagedInNewWindow: boolean, open unmanaged links in new window/tab
    */
    "view": {
        "binaryPrefix": false,
        "disableSidebar": false,
        "fallbackMode": false,
        "fastBrowsing": true,
        "fonts": [],
        "fontsMono": [],
        "hidden": ["^\\.", "^_h6ai", "^_h5ai"],
        "hideFolders": false,
        "hideIf403": true,
        "hideParentFolder": false,
        "maxEntries": 20000,
        "maxIconSize": 40,
        "modes": ["details", "grid", "icons"],
        "modeToggle": false,
        "setParentFolderLabels": false,
        "sizes": [20, 40, 60, 80, 100, 140, 180, 220, 260, 300],
        "theme": "comity",
        "unmanaged": ["index.html", "index.htm", "index.php"],
        "unmanagedInNewWindow": false
    },



    /*** Extensions (in alphabetical order) ***/



    /*
    Watch and update current folder content.

    - interval: number, update interval in milliseconds, at least 1000
    */
    "autorefresh": {
        "enabled": false,
        "interval": 5000
    },



    /*
    Show a clickable breadcrumb.
    */
    "crumb": {
        "enabled": true
    },



    /*
    Allow customized header and footer files.

    First checks for files "_h6ai.header.html" and "_h6ai.footer.html" in the current directory.
    If not successful it checks all parent directories (starting in the current directory) for
    files "_h6ai.headers.html" and "_h6ai.footers.html".
    Note the different filenames: "header" (only current) - "headers" (current and sub directories)!
    The file's content will be placed inside a <div/> tag above/below the main content.
    If a file's extension is ".md" instead of ".html" its content will be interpreted as markdown.

    Markdown is always sanitized. HTML is sanitized as well (scripts, event handlers etc. are
    removed) unless "allowUnsafeHtml" is true.

    - allowUnsafeHtml: boolean, inject "*.html" files unsanitized. Only enable this if nobody
        untrusted can write files into the served folders.
    - stopSearchingAtRoot: boolean, only search for header and footer files until the web root
        directory. if `false`, will search for header/footer up the entire directory structure,
        even above the web root
    */
    "custom": {
        "enabled": true,
        "allowUnsafeHtml": false,
        "stopSearchingAtRoot": true
    },



    /*
    Enable packaged download of selected entries.
    To select files the "select"-extension needs to be enabled.

    - type: string, "php-tar", "shell-tar" or "shell-zip". Only this type is accepted
        by the server.
    - packageName: string, basename of the download package, null for current filename or foldername
    - alwaysVisible: boolean, always show download button (defaults to download the current folder)
    - maxEntries: number, max files and folders in one packaged download
    */
    "download": {
        "enabled": true,
        "type": "php-tar",
        "packageName": null,
        "alwaysVisible": false,
        "maxEntries": 200000
    },



    /*
    Allow filtering the displayed files and folders in current folder.
    Checks for substrings.

    If advanced is enabled it checks entries for right order of characters,
    i.e. "ab" matches "ab", "axb", "xaxbx" but not "ba". Space separated
    sequences get OR-ed. Searches will be treated as JavaScript regular
    expressions if you prefix them with "re:".

    - advanced: boolean, use advanced pattern parsing
    - debounceTime: number, debounce wait time in milliseconds
    - ignorecase: boolean, ignore case
    */
    "filter": {
        "enabled": true,
        "advanced": true,
        "debounceTime": 100,
        "ignorecase": true
    },



    /*
    Calc the size of folders.

    This operation is real slow. The calculated sizes differ slightly for both
    calculation types since "php" only adds the file size, while "shell-du"
    also adds the sizes for the actual folder files.

    - type: string, "php" (sloooow) or "shell-du" (sloow)
    - cacheTtl: number, seconds a computed folder size is cached in the private cache, 0 to disable
    */
    "foldersize": {
        "enabled": true,
        "type": "php",
        "cacheTtl": 600
    },



    /*
    Enable a generic info side bar.

    - show: boolean, initial visible to first time users
    - qrcode: boolean, show a QR-Code
    - qrFill: string, QR-Code fill color
    - qrBack: string, QR-Code background color
    */
    "info": {
        "enabled": true,
        "show": false,
        "qrcode": true,
        "qrFill": "#1f2328",
        "qrBack": "#ffffff"
    },



    /*
    Localization, for example "en", "de" etc. - see "_h6ai/private/conf/l10n" folder for
    possible values. Adjust it to your needs. If lang is not found
    it defaults to "en".

    - lang: string, default language
    - useBrowserLang: boolean, try to use browser language
    */
    "l10n": {
        "enabled": true,
        "lang": "en",
        "useBrowserLang": true
    },



    /*
    Adds the Matomo (formerly Piwik) tracker. The old "piwik-analytics" key is still read.
    The tracker is loaded via https, its origin is added to the Content-Security-Policy.

    - baseURL: string, do not include the protocol, e.g. "mydomain.tld/matomo"
    - idSite: number
    */
    "matomo-analytics": {
        "enabled": false,
        "baseURL": "some/url",
        "idSite": 1
    },



    /*
    Play a audio preview on click.

    - autoplay: start playing as soon as ready
    - types: array of strings
    */
    "preview-aud": {
        "enabled": true,
        "autoplay": true,
        "types": ["aud"]
    },



    /*
    Show an image preview on click.

    - types: array of strings
    - size: number, sample size, or false for original size
    */
    "preview-img": {
        "enabled": true,
        "size": false,
        "types": ["img", "img-avif", "img-bmp", "img-gif", "img-ico", "img-jpg", "img-png", "img-raw", "img-svg", "img-webp"]
    },



    /*
    Show text file preview on click.
    "txt-md" files are rendered as sanitized markdown.

    Available styles are:
      0: floating text
      1: fixed width text
      2: markdown
      3: syntax highlighting

    - styles: dict string to int, maps types to styles
    */
    "preview-txt": {
        "enabled": true,
        "styles": {
            "txt": 1,
            "txt-authors": 1,
            "txt-c": 3,
            "txt-cpp": 3,
            "txt-css": 3,
            "txt-diff": 1,
            "txt-go": 3,
            "txt-h": 3,
            "txt-hpp": 3,
            "txt-install": 1,
            "txt-js": 3,
            "txt-json": 3,
            "txt-less": 3,
            "txt-license": 1,
            "txt-log": 1,
            "txt-makefile": 1,
            "txt-md": 2,
            "txt-py": 3,
            "txt-rb": 3,
            "txt-readme": 1,
            "txt-rtf": 1,
            "txt-rust": 3,
            "txt-script": 3,
            "txt-xml": 1
        }
    },



    /*
    Play a video preview on click.

    - autoplay: start playing as soon as ready
    - types: array of strings
    */
    "preview-vid": {
        "enabled": true,
        "autoplay": true,
        "types": ["vid-mkv", "vid-mov", "vid-mp4", "vid-webm"]
    },



    /*
    Allow searching files and folders in and below current folder.
    Checks for substrings.

    If advanced is enabled it checks entries for right order of characters,
    i.e. "ab" matches "ab", "axb", "xaxbx" but not "ba". Space separated
    sequences get OR-ed. Searches will be treated as JavaScript regular
    expressions if you prefix them with "re:".

    - advanced: boolean, use advanced pattern parsing
    - debounceTime: number, debounce wait time in milliseconds
    - ignorecase: boolean, ignore case
    - maxResults: number, stop searching after this many matches
    - timeLimit: number, stop searching after this many seconds
    */
    "search": {
        "enabled": false,
        "advanced": true,
        "debounceTime": 300,
        "ignorecase": true,
        "maxResults": 1000,
        "timeLimit": 10
    },



    /*
    Make entries selectable.
    At the moment only needed for packaged download.

    - clickndrag: boolean, allow first mouse button + drag selection
    - checkboxes: boolean, show a checkbox on mouse over item
    */
    "select": {
        "enabled": true,
        "clickndrag": true,
        "checkboxes": true
    },



    /*
    Default sort order.
    "column" and "reverse" are locally stored.

    - column: number, 0 for "Name", 1 for "Date", 2 for "Size"
    - reverse: boolean, false for ascending, true for descending
    - ignorecase: boolean, compare ignorecase
    - natural: boolean, use natural sort order
    - folders: number, where to place folders, 0 for "top", 1 for "in place", 2 for "bottom"
    */
    "sort": {
        "enabled": true,
        "column": 0,
        "reverse": false,
        "ignorecase": true,
        "natural": true,
        "folders": 0
    },



    /*
    Show thumbnails for image files. Needs the "/_h6ai/public/cache" folder to be
    writable for the web Server.

    - img: array of strings
    - mov: array of strings
    - doc: array of strings, only "x-pdf" and "x-ps" are supported
    - delay: number, delay in milliseconds after "dom-ready" before thumb-requesting starts
    - size: number, size in pixel of the generated thumbnails
    - exif: boolean, use included EXIF thumbs if possible
    - chunksize: int, number of thumbs per request
    - maxPixels: int, source images with more pixels are skipped (protects server memory)
    - cacheMaxSize: int, max size of the thumbnail cache in MB, oldest thumbnails are pruned
    */
    "thumbnails": {
        "enabled": true,
        "img": ["img-avif", "img-bmp", "img-gif", "img-ico", "img-jpg", "img-png", "img-webp"],
        "mov": ["vid-avi", "vid-flv", "vid-mkv", "vid-mov", "vid-mp4", "vid-mpg", "vid-webm"],
        "doc": ["x-pdf", "x-ps"],
        "delay": 1,
        "size": 240,
        "exif": false,
        "chunksize": 20,
        "maxPixels": 40000000,
        "cacheMaxSize": 1024
    },



    /*
    Replace window title with current breadcrumb.
    */
    "title": {
        "enabled": true
    },



    /*
    Show a folder tree.
    Note that this might affect performance significantly.

    - show: boolean, initial visible to first time users
    - maxSubfolders: number, max number of subfolders to show in tree
    - naturalSort: boolean, use natural sort order for folders
    - ignorecase: boolean, sort ignorecase
    */
    "tree": {
        "enabled": true,
        "show": false,
        "maxSubfolders": 50,
        "naturalSort": true,
        "ignorecase": true
    }
}
